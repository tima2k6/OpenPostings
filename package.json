{
  "name": "openpostings",
  "version": "2.0.1",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "server": "node server/index.js",
    "mcp:apply-agent": "node server/mcp-apply-server.js",
    "prepare:android:backend": "node ./scripts/android/prepare-node-backend.mjs",
    "postinstall": "patch-package",
    "start": "expo start",
    "web": "expo start --web",
    "android": "npm run prepare:android:backend && expo run:android",
    "windows": "npx @react-native-community/cli run-windows",
    "export_windows_build": "powershell -ExecutionPolicy Bypass -File ./scripts/windows/export-windows-msi.ps1",
    "test:windows": "jest --config jest.config.windows.js",
    "test:backend": "node --check server/index.js && node --check server/mcp-apply-server.js",
    "test:backend:seeded-source": "node server/tests/seeded-source-parser.test.js",
    "test:backend:location-filter": "node server/tests/location-state-filter.test.js",
    "test:backend:mcp-candidate-filters": "node server/tests/mcp-candidate-filters.test.js",
    "test:backend:posting-foundation": "node server/tests/posting-classification.test.js && node server/tests/posting-review.test.js && node server/tests/posting-review-pagination.test.js && node server/tests/migration-review-state.test.js && node server/tests/api-network.test.js && node server/tests/api-review-state.test.js",
    "test:backend:applicant-documents": "node server/tests/applicant-documents.test.js",
    "test:backend:application-answers": "node server/tests/application-answers.test.js",
    "test:backend:cover-letter": "node server/tests/cover-letter.test.js",
    "test:backend:enrichment-runtime": "node server/tests/enrichment-runtime.test.js",
    "test:backend:hidden-reason": "node server/tests/hidden-reason.test.js",
    "test:backend:error-log": "node server/tests/error-log.test.js",
    "test:backend:write-transaction": "node server/tests/write-transaction.test.js",
    "test:backend:write-liveness": "node server/tests/write-liveness.test.js",
    "test:backend:sync-resume": "node server/tests/sync-resume.test.js",
    "test:filter-normalize": "node server/tests/filter-normalize.test.js",
    "test:backend:api-request-errors": "node server/tests/api-request-errors.test.js",
    "test:backend:db-browser": "node server/tests/db-browser.test.js",
    "test:backend:db-query": "node server/tests/db-query.test.js",
    "test:backend:structured-location": "node server/tests/structured-location.test.js",
    "test:backend:posting-page-fetcher": "node server/tests/posting-page-fetcher.test.js",
    "test:backend:db-facets": "node server/tests/db-facets.test.js",
    "test:backend:saved-queries": "node server/tests/saved-queries.test.js",
    "test:backend:posting-retention": "node server/tests/posting-retention.test.js",
    "test:backend:posting-query-plan": "node server/tests/posting-query-plan.test.js",
    "test:backend:posting-filter-pushdown": "node server/tests/posting-filter-pushdown.test.js",
    "test:backend:amazon-parser": "node server/tests/amazon-parser.test.js",
    "test:backend:careersite-parser": "node server/tests/careersite-parser.test.js",
    "test:backend:microsoft-parser": "node server/tests/microsoft-parser.test.js",
    "test:backend:board-sweep-bounds": "node server/tests/board-sweep-bounds.test.js",
    "test:backend:sync-flush-queue": "node server/tests/sync-flush-queue.test.js",
    "apply": "./scripts/apply.sh",
    "apply:status": "./scripts/apply.sh status",
    "logs:server": "journalctl -u openpostings-server -n 50 -f",
    "lite:build-chunks": "node ./scripts/lite/build-lite-chunks.mjs",
    "lite:benchmark": "node ./scripts/lite/benchmark-lite-pipeline.mjs",
    "ios": "expo run:ios"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "^12.0.1",
    "babel-preset-expo": "~54.0.10",
    "cors": "^2.8.6",
    "expo": "~54.0.0",
    "expo-file-system": "^55.0.19",
    "express": "^5.2.1",
    "nodejs-mobile-react-native": "^18.20.4",
    "pdfjs-dist": "^4.10.38",
    "react": "^19.1.4",
    "react-dom": "^19.1.4",
    "react-native": "0.81.6",
    "react-native-background-actions": "^4.1.0",
    "react-native-web": "^0.21.0",
    "react-native-windows": "0.81.12",
    "sqlite": "^5.1.1",
    "sqlite3": "^6.0.1"
  },
  "devDependencies": {
    "@react-native/metro-config": "^0.81.6",
    "@rnx-kit/jest-preset": "^0.1.17",
    "patch-package": "^8.0.1"
  },
  "react-native-windows": {
    "init-windows": {
      "name": "openpostings",
      "namespace": "openpostings",
      "template": "cpp-app"
    }
  },
  "allowScripts": {
    "sqlite3@6.0.1": true,
    "nodejs-mobile-react-native": false
  }
}
